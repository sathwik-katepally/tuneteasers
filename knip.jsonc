{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      // e2e/group-edge.mjs imports the client module through the Vite dev server URL.
      "ignoreUnresolved": ["/src/lib/group.ts"]
    },
    "worker": {
      // The verify job installs only the root's dependencies, so there Knip cannot tie the
      // wrangler command in the worker's scripts to its package.
      "ignoreBinaries": ["wrangler"],
      "ignoreDependencies": ["wrangler"]
    }
  }
}
