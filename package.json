{
  "name": "tuneteasers",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "build": "vite build",
    "preview": "vite preview",
    "build:catalog": "node scripts/build-catalog.mjs",
    "build:snips": "node scripts/build-snips.mjs",
    "e2e:game": "node --experimental-strip-types e2e/game.mjs",
    "e2e:categories": "node e2e/categories.mjs",
    "e2e:ladder": "node --experimental-strip-types e2e/ladder.mjs",
    "e2e:migrate": "node e2e/migrate.mjs",
    "e2e:autoplay": "node e2e/autoplay.mjs",
    "e2e:offline": "node e2e/offline.mjs",
    "e2e:snips": "node --experimental-strip-types e2e/safe-snips.mjs",
    "e2e:group": "node e2e/group-sync.mjs",
    "e2e:group-edge": "node --experimental-strip-types e2e/group-edge.mjs",
    "e2e:room": "node --experimental-strip-types e2e/room.mjs",
    "e2e:room-norepeat": "node e2e/room-norepeat.mjs",
    "e2e:room-background": "node e2e/room-background.mjs",
    "e2e:landing": "node --experimental-strip-types e2e/landing.mjs",
    "e2e:journeys": "node e2e/journeys.mjs"
  },
  "dependencies": {
    "@fontsource/mukta": "^5.3.0",
    "@fontsource/rozha-one": "^5.3.0",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "partysocket": "^1.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "1.86.0",
    "playwright": "^1.62.1",
    "proper-lockfile": "^4.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
